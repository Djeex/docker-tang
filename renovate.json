{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "tang and jose release tags built from source in the Dockerfile",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\S+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "CI tool images started with docker run/create in the workflow",
      "fileMatch": ["(^|/)\\.gitea/workflows/[^/]+\\.ya?ml$"],
      "matchStrings": [
        "(?<depName>aquasec/trivy|zricethezav/gitleaks|hadolint/hadolint):(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
